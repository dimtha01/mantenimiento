{
  "name": "mantenimiento",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "env-cmd -f .env --silent turbo dev",
    "dev:api": "env-cmd -f .env --silent turbo dev --filter=api",
    "build": "turbo run build",
    "start": "node apps/api/src/index.js",
    "lint": "turbo run lint",
    "db:migrate": "env-cmd -f .env pnpm dlx --package=prisma@6.19.2 prisma migrate dev --schema=apps/api/prisma/schema",
    "db:studio": "env-cmd -f .env pnpm dlx --package=prisma@6.19.2 prisma studio --schema=apps/api/prisma/schema",
    "db:push": "env-cmd -f .env pnpm dlx --package=prisma@6.19.2 prisma db push --schema=apps/api/prisma/schema",
    "db:pull": "env-cmd -f .env pnpm dlx --package=prisma@6.19.2 prisma db pull --schema=apps/api/prisma/schema",
    "db:generate": "env-cmd -f .env pnpm dlx --package=prisma@6.19.2 prisma generate --schema=apps/api/prisma/schema",
    "db:reset": "env-cmd -f .env pnpm dlx --package=prisma@6.19.2 prisma migrate reset --schema=apps/api/prisma/schema --force",
    "db:seed": "env-cmd -f .env pnpm --filter=api exec tsx prisma/seed.js",
    "railway:db:migrate": "pnpm dlx --package=prisma@6.19.2 prisma migrate deploy --schema=apps/api/prisma/schema",
    "railway:db:generate": "pnpm dlx --package=prisma@6.19.2 prisma generate --schema=apps/api/prisma/schema",
    "railway:start": "turbo start --filter=api",
    "cloud:migrate": "pnpm dlx --package=prisma@6.19.2 prisma migrate deploy --schema=apps/api/prisma/schema",
    "cloud:generate": "pnpm dlx --package=prisma@6.19.2 prisma generate --schema=apps/api/prisma/schema",
    "cloud:seed": "pnpm --filter=api exec tsx prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "env-cmd": "^11.0.0",
    "turbo": "^2.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react-router-dom": "^7.13.1"
  }
}