model Equipo {
  id      Int     @id @default(autoincrement())
  codigo  String
  modelo  String
  serial  String
  factura Boolean @default(false)

  tipoId          Int @map("tipo_id")
  marcaId         Int @map("marca_id")
  unidadNegocioId Int @map("unidad_negocio_id")
  propietarioId   Int @map("propietario_id")
  parametroId     Int @map("parametro_id")

  // Ficha técnica dinámica (JSON de pares clave-valor)
  fichaTecnica Json? @default("[]") @map("ficha_tecnica")

  // Campos para control de mantenimiento basado en horas
  horasMantenimientoPreventivo Int?      @default(0) @map("horas_mantenimiento_preventivo")
  horasAcumuladas              Int?      @default(0) @map("horas_acumuladas")
  horometroActual              Int?      @default(0) @map("horometro_actual")
  ultimaFechaHoras             DateTime? @map("ultima_fecha_horas") @db.Date

  // Estado operativo del equipo
  estadoOperativo String @default("OPERATIVO") @map("estado_operativo")

  tipo        TipoEquipo       @relation(fields: [tipoId], references: [id])
  marca       Marca            @relation(fields: [marcaId], references: [id])
  ubicacion   UbicacionEquipo  @relation(fields: [unidadNegocioId], references: [id])
  propietario Propietario      @relation(fields: [propietarioId], references: [id])
  parametro   ParametroControl @relation(fields: [parametroId], references: [id])

  certificaciones CertificacionHistorial[]
  planes          PlanPreventivo[]
  mantenimientos  RegistroMantenimiento[]
  fallas          RegistroFalla[]
  alertas         AlertaPreventiva[]

  imagenes Imagen[]

  @@index([tipoId])
  @@index([marcaId])
  @@index([unidadNegocioId])
  @@index([propietarioId])
  @@index([parametroId])
  @@map("equipos")
}
