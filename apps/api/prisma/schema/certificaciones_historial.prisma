model CertificacionHistorial {
  id            Int      @id @default(autoincrement())
  equipoId      Int      @map("equipo_id")
  nombre        String   @default("Certificación General")
  fechaEmision  DateTime @map("fecha_emision") @db.Date
  duracionMeses Int      @map("duracion_meses")
  vencimiento   DateTime @map("vencimiento") @db.Date

  equipo Equipo @relation(fields: [equipoId], references: [id])
  // Attachments se manejan polimórficamente sin relación explícita

  @@index([equipoId])
  @@map("certificaciones_historial")
}
