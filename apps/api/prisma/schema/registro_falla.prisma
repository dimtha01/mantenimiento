model RegistroFalla {
    id              Int       @id @default(autoincrement())
    equipoId        Int       @map("equipo_id")
    fecha           DateTime  @default(now()) @db.Date
    descripcion     String    @db.Text
    severidad       String    @default("MEDIA") // BAJA | MEDIA | ALTA | CRITICA
    estado          String    @default("ABIERTA") // ABIERTA | EN_PROCESO | RESUELTA
    solucion        String?   @db.Text
    fechaResolucion DateTime? @map("fecha_resolucion") @db.Date

    // Campos nuevos
    responsable     String?  @db.VarChar(255)
    costoReparacion Decimal? @map("costo_reparacion") @db.Decimal(12, 2)

    equipo    Equipo          @relation(fields: [equipoId], references: [id])
    repuestos RepuestoFalla[]
    // Attachments se manejan polimórficamente sin relación explícita

    @@index([equipoId])
    @@map("registro_fallas")
}
